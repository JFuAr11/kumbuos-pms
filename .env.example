GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash,gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it,gemma-3-1b-it

# Firebase web app identifiers used by the frontend to enable Firebase-backed sync status.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_CREDENTIAL_STORE_ID=production-v3-root-baseline
VITE_FIREBASE_PMS_STORE_ID=test-v3-empty

# Firebase Admin bridge used by Vercel serverless functions to read/write Firestore securely.
# If GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY already belong to the Firebase project,
# FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY can be omitted.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CREDENTIAL_STORE_ID=production-v3-root-baseline
FIREBASE_PMS_STORE_ID=test-v3-empty

# Zoho Mail SMTP used by Forgot your password?
ZOHO_SMTP_USER=info@luxurytentedcamp.com
ZOHO_SMTP_PASSWORD=your_zoho_app_password
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
