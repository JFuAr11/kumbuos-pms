GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash,gemma-3-27b-it,gemma-3-12b-it,gemma-3-4b-it,gemma-3-1b-it

# Firebase client SDK used for the KumbuOS credential store sync
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Zoho Mail SMTP used by Forgot your password?
ZOHO_SMTP_USER=info@luxurytentedcamp.com
ZOHO_SMTP_PASSWORD=your_zoho_app_password
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
